# Local development. Generate random local credentials with node scripts/init-env.mjs.
MONGODB_URI=mongodb://127.0.0.1:27017/agil?replicaSet=agil
JWT_SECRET=replace-with-at-least-32-random-characters
SERVICE_TOKEN=replace-with-random-shared-service-secret
DEMO_PASSWORD=choose-a-local-demo-password-at-least-12-characters
VALIDATION_URL=http://127.0.0.1:5001
VALIDATION_DB=/absolute/path/to/durable/validation.sqlite
UPLOAD_DIR=/absolute/path/to/durable/uploads
PORT=3001
# Optional external safety emails; persisted in-app notification is always authoritative.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
