NODE_ENV=production
NODE_VERSION=24.22.1
PORT=10000
MONGODB_URI=replace-with-secret-Atlas-URI-for-agil_production
JWT_SECRET=replace-with-unique-random-secret-at-least-32-characters
SERVICE_TOKEN=replace-with-random-secret-shared-with-Flask
VALIDATION_HOST=replace-with-Flask-internal-host
VALIDATION_PORT=10000
# Alternative for manual setup: VALIDATION_URL=http://actual-internal-host:10000
UPLOAD_DIR=/var/data/uploads
TRUST_PROXY_HOPS=1
ALLOW_SYNTHETIC_DEMO=false
# Optional exact browser origins, comma-separated; no wildcard or trailing slash.
# Leave unset for same-origin /api proxy only.
# CORS_ORIGINS=https://your-project.vercel.app
